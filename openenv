#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"

usage() {
  cat <<'EOF'
Usage:
  openenv validate

Commands:
  validate   Run the repository validation checks.
EOF
}

cmd="${1:-}"
case "$cmd" in
  validate)
    shift || true
    if [[ $# -gt 0 ]]; then
      echo "Unexpected arguments for validate: $*" >&2
      exit 2
    fi
    cd "$ROOT_DIR"
    python validate_env.py
    ;;
  ""|-h|--help|help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
